      "body": "position:absolute;bottom:0;left:0;height:2px;background:rgba(245,166,35,0.4);transition:width 0.1s linear;pointer-events:none;"
    },
    {
      "selector": ".sp-lapbar.fast",
      "body": "background:rgba(34,197,94,0.5);"
    },
    {
      "selector": ".sp-lapbar.slow",
      "body": "background:rgba(239,68,68,0.4);"
    },
    {
      "selector": ".sp-kpis",
      "body": "display:grid;grid-template-columns:repeat(4,1fr);gap:10px;-webkit-app-region:no-drag;"
    },
    {
      "selector": ".sp-thead",
      "body": "display:grid;grid-template-columns:20px 48px 44px 1fr 48px 88px 88px 72px 64px 76px 36px;padding:5px 14px;border-bottom:0.5px solid #1a1b20;flex-shrink:0;"
    },
    {
      "selector": ".sp-thead span",
      "body": "font-size:11.5px;color:#333;text-transform:uppercase;letter-spacing:0.5px;text-align:right;"
    },
    {
      "selector": ".sp-thead span:nth-child(4)",
      "body": "text-align:left;"
    },
    {
      "selector": ".sp-thead span:nth-child(1),.sp-thead span:nth-child(2)",
      "body": "text-align:center;"
    },
    {
      "selector": ".sp-body",
      "body": "overflow-y:auto;flex:1;"
    },
    {
      "selector": ".sp-row",
      "body": "display:grid;grid-template-columns:20px 48px 44px 1fr 48px 88px 88px 72px 64px 76px 36px;padding:7px 14px;border-bottom:0.5px solid #111213;align-items:center;cursor:pointer;position:relative;"
    },
    {
      "selector": ".sp-row:nth-child(odd)",
      "body": "background:rgba(255,255,255,0.01);"
    },
    {
      "selector": ".sp-row:hover",
      "body": "background:#15161d!important;"
    },
    {
      "selector": ".sp-kart",
      "body": "display:inline-flex;align-items:center;justify-content:center;width:30px;height:22px;border-radius:5px;font-size:13.5px;font-weight:700;margin:auto;"
    },
    {
      "selector": ".sp-vtas",
      "body": "font-size:13.5px;color:var(--text-3);text-align:right;font-family:monospace;"
    },
    {
      "selector": ".sp-sec",
      "body": "font-size:12.5px;color:#333;text-align:right;font-family:monospace;"
    },
    {
      "selector": ".sp-pitc",
      "body": "font-size:12.5px;color:#333;text-align:right;font-family:monospace;"
    }
  ]
